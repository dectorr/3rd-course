 "код_студента": {
  "tournament": "def tournament(F, k, rng):\n    candidates_idx=rng.choice(len(F),size=k,replace=True)\n    best_candidate_pos=np.argmin(F[candidates_idx])\n    return int(candidates_idx[best_candidate_pos])\n",
  "ox": "def ox(p1, p2, i, j):\n    n=len(p1)\n    child=np.full(n,-1,dtype=np.asarray(p1).dtype)\n    child[i:j+1]=p1[i:j+1]\n    in_child=set(p1[i:j+1])\n    genes=[p2[(j+1+k)%n] for k in range(n) if p2[(j+1+k)%n] not in in_child]\n    for k,gene in enumerate(genes):\n        child[(j+1+k)%n]=gene\n    return child if isinstance(p1, np.ndarray) else child.tolist()\n",
  "choose_next": "def choose_next(cur, left, tau, eta, alpha, beta, rng):\n    left=np.asarray(left)\n    weights=(tau[cur,left]**alpha*eta[cur,left]**beta)\n    total=np.sum(weights)\n    if total>0:\n        probs=weights/total\n    else:\n        probs=np.full(len(left), 1.0/len(left))\n    next_node=rng.choice(left,p=probs)\n    return int(next_node)\n",
  "update_pheromone": "def update_pheromone(tau, tours, lens, rho):\n    new_tau=(1-rho)*np.asarray(tau,dtype=float)\n    for tour,length in zip(tours,lens):\n        delta=1/length\n        if len(tour)==0:\n            continue\n        new_tau[0,tour[0]]+=delta\n        for i in range(len(tour)-1):\n            new_tau[tour[i],tour[i+1]]+=delta\n        new_tau[tour[-1],0]+=delta\n    return new_tau\n"
 },
